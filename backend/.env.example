APP_NAME=AI Discord Ops Assistant API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/discord_ops
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_REDIRECT_URI=http://localhost:4200/auth/callback
DISCORD_OAUTH_AUTHORIZE_URL=https://discord.com/oauth2/authorize
DISCORD_OAUTH_TOKEN_URL=https://discord.com/api/oauth2/token
DISCORD_OAUTH_SCOPES=identify guilds
DISCORD_BOT_SCOPES=bot applications.commands
DISCORD_BOT_PERMISSIONS=8
SESSION_SIGNING_SECRET=replace_with_strong_secret
DEFAULT_TENANT_HEADER=x-tenant-id

# LLM for intent parsing. Leave LLM_API_KEY blank to use the regex fallback.
# Any OpenAI-compatible endpoint works — swap BASE_URL + MODEL accordingly:
#   OpenAI:     https://api.openai.com/v1                 (gpt-4o-mini)
#   OpenRouter: https://openrouter.ai/api/v1              (anthropic/claude-3.5-haiku)
#   Groq:       https://api.groq.com/openai/v1            (llama-3.3-70b-versatile)
#   Ollama:     http://host.docker.internal:11434/v1      (qwen2.5:7b)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=400
# "json"  — JSON-mode (best for small open-source models like Llama-3.1-8B)
# "tools" — Native tool-calling (better on GPT-4o-mini, Claude, Llama-3.3-70B+)
# Verify with eval/run_intent_eval.py before changing in prod.
LLM_MODE=json
